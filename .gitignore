# Python caches and build output.
# NB: *.py[co], NOT *.py[cod]. A .pyd is a compiled Windows C extension
# (LabGym_LabGrymace/LabGym_LabGrymace_copy/detectron2/_C.cp3*-win_amd64.pyd) and MUST ship -- ignoring it
# leaves Windows users with a broken detectron2.
__pycache__/
*.py[co]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# LabGrymace caches generated next to data
_labgrymace_cache.npz

# Sphinx documentation build output
docs/_build/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Model weights and trained detectors.
# Never commit these: GitHub rejects files >100 MB and the full set is ~2 GB.
# They are distributed separately -- see the "Models" section in README.md.
LabGym_LabGrymace/LabGym_LabGrymace_copy/detectors/
LabGym_LabGrymace/LabGym_LabGrymace_copy/models/
*.pth
*.keras
*.h5
*.pt

# Example videos / datasets
LabGym_LabGrymace/Examples/

# Scratch images accidentally left in the tree
LabGym_LabGrymace/**/Screenshot*.png
LabGym_LabGrymace/**/WechatIMG*.jpg
