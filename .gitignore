# Python caches and build output.
# NB: *.py[co], NOT *.py[cod]. A .pyd is a compiled Windows C extension
# (LabGym/LabGym_LabGrymace/detectron2/_C.cp3*-win_amd64.pyd) and MUST ship -- ignoring it
# leaves Windows users with a broken detectron2.
__pycache__/
*.py[co]
*.egg-info/
*.egg
build/
dist/
.eggs/

# Virtual environments
.venv/
venv/
env/

# LabGrymace caches generated next to data
_labgrymace_cache.npz

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Model weights and trained detectors.
# Never commit these: GitHub rejects files >100 MB and the full set is ~2 GB.
# They are distributed separately -- see the "Models" section in README.md.
LabGym/LabGym_LabGrymace/detectors/
LabGym/LabGym_LabGrymace/models/
*.pth
*.keras
*.h5
*.pt

# Example videos / datasets
LabGym/Examples/

# Scratch images accidentally left in the tree
LabGym/**/Screenshot*.png
LabGym/**/WechatIMG*.jpg
